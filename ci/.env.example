# Copy to ci/.env and adjust. Never commit ci/.env.
SPROUT_REPO_URL=https://github.com/<your-user>/sprout.git
JENKINS_PORT=8081
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
SPROUT_DB_PASSWORD=change-me-too

# SonarQube (http://localhost:9002, user "admin"). The pipeline replaces the default admin/admin
# password with this one on its first run. Needs 12+ chars with upper, lower, digit and a symbol.
SONAR_PORT=9002
SONAR_ADMIN_PASSWORD=Change-Me-Sonar-123
SONAR_DB_PASSWORD=change-me-sonar-db

# Docker Hub (Push stage). Leave empty to skip pushing; images then stay local.
# Token: hub.docker.com -> Account settings -> Personal access tokens (Read & Write)
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Docker Desktop: 0. Linux host: getent group docker | cut -d: -f3
DOCKER_GID=0
