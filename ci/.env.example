# Copy to ci/.env and adjust. Never commit ci/.env.
SPROUT_REPO_URL=https://github.com/<your-user>/sprout.git
JENKINS_PORT=8081
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# Use a unique password of at least 20 characters. Existing databases keep their original password.
SPROUT_DB_PASSWORD=

# SonarQube: change the admin password through the portal, create the sprout project,
# then give a dedicated CI user Execute Analysis on that project and create a token.
# Add webhook http://jenkins:8080/sonarqube-webhook/ in SonarQube.
SONAR_PORT=9002
SONAR_DB_PASSWORD=
SPROUT_SONAR_TOKEN=

# Docker Hub (Push stage). Leave empty to skip pushing; images then stay local.
# Token: hub.docker.com -> Account settings -> Personal access tokens (Read & Write)
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Docker Desktop: 0. Linux host: getent group docker | cut -d: -f3
DOCKER_GID=0
